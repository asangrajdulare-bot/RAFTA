<!DOCTYPE html><html lang="hi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RAFTA - Park Befikr, Rafta Hai Idhar!</title><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Inter:wght@400;600;800&display=swap" rel="stylesheet"><style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif}
body{background:#0a0a0a;display:flex;justify-content:center}
.phone{max-width:430px;width:100%;background:#f6f5ef;min-height:100vh}
.top{background:#000;padding:28px 20px 32px;text-align:center;border-radius:0 0 30px 30px}
.logo{font-family:Montserrat,sans-serif;font-weight:900;font-size:42px;letter-spacing:3px;color:#FFC600}
.tag-main{color:#fff;font-size:11px;letter-spacing:4px;font-weight:800;margin-top:6px}
.tag-sub{color:#FFC600;font-size:13px;font-weight:600;margin-top:8px}
.card{background:#fff;border-radius:22px;margin:-20px 16px 0;padding:22px;box-shadow:0 16px 40px rgba(0,0,0,.15)}
.badge{background:#000;color:#FFC600;padding:6px 14px;border-radius:20px;font-size:11px;font-weight:800;display:inline-flex;gap:6px;align-items:center}
.dot{width:8px;height:8px;background:#22c55e;border-radius:50%}
.vehicle{font-family:Montserrat,sans-serif;font-weight:800;font-size:28px;text-align:center;margin:14px 0 4px}
.owner-line{text-align:center;color:#666;font-size:13px}
.row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f1f1f1;font-size:13px}.row b{color:#111}
.btn{width:100%;padding:16px;border-radius:14px;font-weight:800;margin-top:12px;display:flex;justify-content:center;text-decoration:none;font-size:15px}
.btn-call{background:#000;color:#fff}.btn-wa{background:#25D366;color:#fff}
.hint{text-align:center;font-size:10px;color:#999;margin-top:5px}
.box{background:#fffbeb;border:1px solid #fde68a;border-radius:16px;padding:16px;margin:16px;font-size:12px;line-height:1.6}
</style></head><body><div class="phone"><div class="top"><div class="logo">RAFTA</div><div class="tag-main">SMART PARKING SOLUTION</div><div class="tag-sub">Park Befikr, RAFTA Hai Idhar!</div></div><div class="card" id="main">⏳ Loading RAFTA...</div><div class="box"><b>🚗 Ye QR Kya Problem Solve Kar Raha Hai?</b><br><br><b>✅ Wrong Parking Se Chhutkara:</b> Gaadi galat jagah khadi hai? Paper pe number dhoondhne ki zarurat nahi, bas QR scan karo aur owner ko direct call karo.<br><br><b>✅ Number Private Rahega:</b> Aapka mobile number koi dekh nahi payega, sirf CALL NOW aur WHATSAPP button se baat hogi. Spam aur fraud se safe!<br><br><b>✅ Bihar Ka Apna Brand:</b> Bahar ke apps nahi, apna RAFTA - Supaul, Saharsa, Madhubani, Patna sab jagah kaam karega. Ek QR, poora Bihar connect!</div><div style="text-align:center;padding:14px;font-size:10px;color:#aaa">POWERED BY RAFTA • MADE IN BIHAR • 100% SECURE</div></div><script>
async function load(){let q=new URLSearchParams(location.search).get('qr');q=(q||'').toUpperCase().trim();if(!q){document.getElementById('main').innerHTML="<h3 style='text-align:center'>QR ID nahi mila<br><small>QR scan se kholo</small></h3>";return}
try{let db=await fetch('data.json?v='+Date.now()).then(r=>r.json());let d=db[q];if(!d){document.getElementById('main').innerHTML=`<div style='text-align:center'><span class='badge'>${q}</span><h3 style='margin-top:12px'>${q} Active Nahi Hai</h3><p style='color:#666;font-size:13px'>Admin panel me isko active karo</p></div>`;return}
let wa=`https://wa.me/91${d.whatsapp}?text=${encodeURIComponent(`Namaste ${d.owner} Ji! Aapki Gaadi ${d.vehicle} (${q}) parking me hai - RAFTA`)}`;
document.getElementById('main').innerHTML=`<div style='text-align:center'><span class='badge'><span class='dot'></span>LIVE • ${q} • VERIFIED</span><div class='vehicle'>${d.vehicle}</div><div class='owner-line'>Owner: <b>${d.owner}</b> • ${d.profession}</div></div><div style='margin-top:16px'><div class='row'><span>Vehicle No</span><b>${d.vehicle}</b></div><div class='row'><span>Owner</span><b>${d.owner}</b></div><div class='row'><span>Kaam</span><b>${d.profession}</b></div><div class='row'><span>Status</span><b style='color:green'>● Verified</b></div></div><a class='btn btn-call' href='tel:+91${d.mobile}'>📞 CALL NOW</a><div class='hint'>Number hidden - click pe call lagega</div><a class='btn btn-wa' href='${wa}' target='_blank'>💬 WHATSAPP MESSAGE</a><div class='hint'>Click pe direct chat khulega</div>`;
}catch(e){document.getElementById('main').innerHTML="Error: "+e.message}}load();
</script></body></html>
