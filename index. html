<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RAFTA PUBLIC HELP</title>
<style>body{margin:0;font-family:system-ui;background:#fff}.top{background:#0b1220;color:#fff;padding:12px;display:flex;justify-content:space-between}
.logo{width:36px;height:36px;background:#ffcc00;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#000;font-weight:900}
.hero{background:linear-gradient(#0b1220,#1a2640);color:#fff;text-align:center;padding:20px;border-radius:0 0 24px 24px}
.hero h1{font-size:36px;font-weight:900}.hero span{color:#ffcc00}.tag{background:#ffcc00;color:#000;padding:6px 12px;border-radius:20px;font-weight:800;font-size:12px;display:inline-block;margin-top:8px}
.card{margin:16px;background:#fff;border-radius:16px;padding:16px;box-shadow:0 4px 20px rgba(0,0,0,.08)}
.btn{display:block;padding:12px;text-align:center;border-radius:12px;text-decoration:none;font-weight:800;margin-top:10px}
.call{background:#111;color:#fff}.wa{background:#25D366;color:#fff}</style></head><body>
<div class="top"><div class="logo">R</div><b style="font-size:20px">RAFTA</b><div style="width:36px"></div></div>
<div class="hero"><h1>RAF<span>TA</span></h1><div class="tag">Parking ka Tension Khatam, RAFTA Hai Na!</div></div>
<div class="card"><small>QR ID</small><h2 id="qid">RAFTA001</h2><small>CAR NUMBER</small><h2 id="car">Loading...</h2>
<a id="cbtn" class="btn call">CALL OWNER</a><a id="wbtn" class="btn wa">WHATSAPP OWNER</a></div>
<div class="card"><small>IS QR SE KITNI PROBLEM SOLVE</small><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
<div>✓ Wrong Parking Band</div><div>✓ Direct Connect</div><div>✓ Smart QR</div><div>✓ 24/7 Help</div></div></div>
<script>let q=new URLSearchParams(location.search).get('qr')||'RAFTA001';document.getElementById('qid').innerText=q;
let db=JSON.parse(localStorage.getItem('rafta_db')||'{}');if(db[q]){document.getElementById('car').innerText=db[q].car;cbtn.href='tel:'+db[q].wa;wbtn.href='https://wa.me/'+db[q].wa.replace(/\D/g,'')}</script>
</body></html>
