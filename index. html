<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RAFTA</title><style>body{margin:0;background:#faf7f2;font-family:sans-serif;display:flex;justify-content:center;align-items:center;min-height:100vh}.box{background:#fff;padding:30px;border-radius:20px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.1);width:90%;max-width:380px}</style></head><body><div class="box" id="box">Loading...</div><script>let db={...JSON.parse(localStorage.getItem('rafta_final')||'{}'),...JSON.parse(localStorage.getItem('rafta')||'{}')};let p=new URLSearchParams(location.search);let q=(p.get('qr')||p.get('id')||location.hash.replace('#','')).toUpperCase().trim();if(!q){box.innerHTML='<h2>RAFTA QR Tag</h2><p>QR ID URL me nahi hai.<br>Example:?qr=RAFTA001</p>'}else{let d=db[q];if(!d){box.innerHTML=`<h2>${q}</h2><p style="color:red">⚠️ Ye QR abhi active nahi hai</p><p>Agent ko bulaiye activate karne ke liye</p><small>Test ke liye same mobile pe admin se activate karo</small><br><br><a href="admin.html" style="background:#FFC600;padding:10px 20px;border-radius:10px;text-decoration:none;color:#000;font-weight:bold">Agent Login</a>`}else{box.innerHTML=`<h2>RAFTA - Connecting...</h2><p>Gaadi: ${d.vehicle}<br>Owner: ${d.mobile} (${d.work})</p><p>WhatsApp khul raha hai...</p>`;setTimeout(()=>location.href=d.waLink,1200)}} </script></body></html>
